# Postgres connection (originals and variants are stored here as bytea)
DATABASE_URL=postgresql://postgres:fleetdev@127.0.0.1:55432/thumbs
# Redis for the BullMQ queue
REDIS_URL=redis://127.0.0.1:56379/5
# Bearer token for POST /api/admin/purge (16+ characters)
ADMIN_TOKEN=change-me-to-a-long-random-string
# HTTP port for the web process
PORT=5115
# Run the BullMQ worker inside the web process (true/false)
RUN_WORKER=true
# Jobs processed in parallel per worker
WORKER_CONCURRENCY=2
# Images older than this are purged by the daily clean-up job
RETENTION_DAYS=30
# Optional: start a tiny health server in worker-only mode on this port
# WORKER_HEALTH_PORT=5116
